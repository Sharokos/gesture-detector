# Copy this file to ".env" (same folder) and adjust the paths.
# Use absolute paths. Lines starting with # are ignored.

# Folder with the videos to process (sub-folders are searched too).
# Results go to a sibling folder named OUTPUT_<this folder's name>.
INPUT_DIR=C:\path\to\gesture-detector\INPUT_VIDEOS

# Step 1: extract keypoints from the videos (slow part). Step 2: detect gestures from the keypoints.
# Turn GENERATE_JSONS off to re-run only the detection on keypoints you already have.
GENERATE_JSONS=True
GESTURE_DETECTION=True

# Keypoint extractor: rtmpose (recommended, no extra install) or openpose
POSE_BACKEND=rtmpose
# lightweight (fastest) | balanced (default) | performance (most accurate, slowest)
RTMPOSE_MODE=balanced
# cpu, or cuda with onnxruntime-gpu installed (see INSTALL.md)
RTMPOSE_DEVICE=cpu
# Run the person detector every N frames (the person is tracked in between)
RTMPOSE_DET_EVERY=15

# Also extract hand keypoints (slower; not used by the gesture score)
POSE_HANDS=False
# Write a skeleton overlay video next to the keypoints (slow; for visual checks only)
WRITE_POSE_VIDEO=False
# Don't extract keypoints again for videos that already have them
SKIP_EXISTING_JSONS=True

# Gesture threshold: otsu (adapts to each video) or percentile (old behaviour)
THRESHOLD_METHOD=otsu

# Only needed when POSE_BACKEND=openpose
OPEN_POSE_DIR=C:\path\to\openpose
RESOLUTION=176x-1
